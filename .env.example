# Configuracao de Ambiente — Ponto Academico FATEC
# Copie para .env caso queira personalizar credenciais OAuth de producao.
# Em ambiente local Docker, os valores padrao ja sobem tudo pronto.

ADMIN_EMAIL=gabrielpedra1999@gmail.com
ALLOWED_EMAIL_DOMAINS=fatec.sp.gov.br,cps.sp.gov.br
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
APP_SECRET=trocar-esta-chave-em-producao

# Em producao HTTPS altere: COOKIE_SECURE=true, COOKIE_SAMESITE=none, ALLOW_LOCAL_DEMO_LOGIN=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_LOCAL_DEMO_LOGIN=true

# Google OAuth 2.0 (opcional em modo local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Microsoft Azure Entra ID (opcional em modo local)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=organizations
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
